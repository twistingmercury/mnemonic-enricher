# mnemonic-enricher environment

## Optional build metadata for an exported or sourced build environment

BUILD_VER=v0.0.0-dev
BUILD_COMMIT=dev
BUILD_DATE=2026-01-29T00:00:00Z

## Root Compose runtime (`cp src/.env.example .env`)

### OpenAI key required for live embeddings and extraction: <https://platform.openai.com/api-keys>

MNEMONIC_OPENAI_API_KEY=

## Direct worker logging (root Compose sets its logging level explicitly)

MNEMONIC_LOGGING_LEVEL=debug
MNEMONIC_LOGGING_FORMAT=text
